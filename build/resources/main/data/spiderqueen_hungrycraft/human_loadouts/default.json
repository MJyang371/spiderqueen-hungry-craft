    "shield": {
      "score_pool": "armor_score",
      "max_count": 1,
      "allow_absent": true
    },
    "melee_weapon": {
      "score_pool": "weapon_score",
      "max_count": 1,
      "allow_unarmed": true
    },
    "bow": {
      "score_pool": "weapon_score",
      "max_count": 1,
      "allow_absent": true,
      "infinite_arrows": true,
      "requires_draw_ticks": 20,
      "crossbow_enabled": false
    },
    "medicine": {
      "score_pool": "medicine_score",
      "golden_apple_only_in_v0_1": true,
      "allow_absent": true
    },
    "enchantments": {
      "enabled": false
    }
  },
